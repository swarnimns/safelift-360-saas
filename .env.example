# ==============================================================================
# SafeLift 360 SaaS — Environment Variables Template
# ==============================================================================
# Copy this file to .env for local development, or set these variables
# in the Railway Project Variables dashboard.
# NEVER commit .env to version control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Session Configuration
# In production, use a strong 32+ character random string
SESSION_SECRET=your_secure_random_session_secret_key_here

# ------------------------------------------------------------------------------
# Option A: Local XAMPP / MySQL Variables
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=safelift360

# ------------------------------------------------------------------------------
# Option B: Railway MySQL Variables (Automatically provided by Railway)
# ------------------------------------------------------------------------------
# MYSQLHOST=mysql.railway.internal
# MYSQLPORT=3306
# MYSQLUSER=root
# MYSQLPASSWORD=generated_railway_password
# MYSQLDATABASE=railway
# MYSQL_URL=mysql://root:password@mysql.railway.internal:3306/railway

# Optional SSL (only set to true if connecting externally and provider requires SSL)
# DB_SSL=false

# ------------------------------------------------------------------------------
# Production Super Admin Initial Bootstrap (Optional)
# ------------------------------------------------------------------------------
# When deploying to a brand-new database in production, set these variables to
# establish the initial administrator account. Once established, they can be removed.
# SUPERADMIN_EMAIL=admin@yourdomain.com
# SUPERADMIN_PASSWORD=YourStrongPasswordHere123!
